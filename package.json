{
  "name": "sql-executor-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Project-isolated, allowlisted PostgreSQL query executor",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "npm run build && node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=22.0.0 <=24.x.x"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pg-cursor": "^2.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
